; Engine configuration file.

config_version=5

[application]

config/name="Hold the Gates"
config/description="City builder in a zombie outbreak."
run/main_scene="res://scenes/main/title.tscn"
run/main_scene.bench3d="res://scenes/tests/bench_3d.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Settings="*res://scripts/autoload/settings.gd"

EventBus="*res://scripts/autoload/event_bus.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Economy="*res://scripts/autoload/economy.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/default_font_size=22
theme/custom="res://data/settlement_theme.tres"

