[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="PackedScene" path="res://scenes/ui/building_info.tscn" id="2_info"]
[ext_resource type="PackedScene" path="res://scenes/ui/perimeter_info.tscn" id="3_perimeter"]
[ext_resource type="PackedScene" path="res://scenes/ui/expedition_panel.tscn" id="4_trips"]
[ext_resource type="PackedScene" path="res://scenes/ui/service_panel.tscn" id="5_services"]
[ext_resource type="PackedScene" path="res://scenes/ui/research_panel.tscn" id="6_tech"]
[ext_resource type="Script" path="res://scripts/ui/opening_guide.gd" id="7_guide"]
[ext_resource type="Script" path="res://scripts/ui/build_palette.gd" id="Palette"]
[ext_resource type="Script" path="res://scripts/ui/hud_status.gd" id="Status"]

[node name="Hud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="StatusBar" type="PanelContainer" parent="."]
anchor_right = 1.0
theme_type_variation = &"StatusBar"
script = ExtResource("Status")

[node name="Flow" type="HFlowContainer" parent="StatusBar"]
theme_override_constants/h_separation = 18
theme_override_constants/v_separation = 6

[node name="Town" type="HBoxContainer" parent="StatusBar/Flow"]
size_flags_horizontal = 3
theme_override_constants/separation = 16

[node name="StationIcon" type="TextureRect" parent="StatusBar/Flow/Town"]
unique_name_in_owner = true
custom_minimum_size = Vector2(39, 39)
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5
modulate = Color(0.94, 0.70, 0.41, 1)

[node name="Location" type="VBoxContainer" parent="StatusBar/Flow/Town"]
theme_override_constants/separation = -3

[node name="Station" type="Label" parent="StatusBar/Flow/Town/Location"]
theme_type_variation = &"Caption"
theme_override_colors/font_color = Color(0.94, 0.75, 0.51, 1)
text = "STATION 4"

[node name="MapName" type="Label" parent="StatusBar/Flow/Town/Location"]
unique_name_in_owner = true
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 26

[node name="Divider" type="VSeparator" parent="StatusBar/Flow/Town"]

[node name="Resources" type="HBoxContainer" parent="StatusBar/Flow/Town"]
unique_name_in_owner = true
theme_override_constants/separation = 22

[node name="Divider2" type="VSeparator" parent="StatusBar/Flow/Town"]

[node name="Population" type="HBoxContainer" parent="StatusBar/Flow/Town"]
unique_name_in_owner = true

[node name="Watch" type="HBoxContainer" parent="StatusBar/Flow"]
theme_override_constants/separation = 18

[node name="Time" type="VBoxContainer" parent="StatusBar/Flow/Watch"]
theme_override_constants/separation = -3

[node name="Day" type="Label" parent="StatusBar/Flow/Watch/Time"]
unique_name_in_owner = true
horizontal_alignment = 2
theme_type_variation = &"Heading"
theme_override_font_sizes/font_size = 25

[node name="Clock" type="Label" parent="StatusBar/Flow/Watch/Time"]
unique_name_in_owner = true
horizontal_alignment = 2
theme_type_variation = &"Caption"

[node name="Speed" type="HBoxContainer" parent="StatusBar/Flow/Watch"]
unique_name_in_owner = true
size_flags_vertical = 4
theme_override_constants/separation = 3

[node name="Reports" type="VBoxContainer" parent="."]
anchor_right = 0.60
offset_left = 18.0
offset_top = 100.0
mouse_filter = 2
theme_override_constants/separation = 5

[node name="CivilianAlert" type="Label" parent="Reports"]
unique_name_in_owner = true
visible = false
theme_type_variation = &"Notice"
theme_override_colors/font_color = Color(1, 0.82, 0.56, 1)
mouse_filter = 2
autowrap_mode = 3

[node name="DawnReport" type="Label" parent="Reports"]
unique_name_in_owner = true
visible = false
theme_type_variation = &"Notice"
mouse_filter = 2
autowrap_mode = 3

[node name="Dock" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
alignment = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Inset" type="MarginContainer" parent="Dock"]
size_flags_horizontal = 0
mouse_filter = 2
theme_override_constants/margin_left = 16

[node name="Palette" type="PanelContainer" parent="Dock/Inset"]
unique_name_in_owner = true
visible = false
script = ExtResource("Palette")

[node name="Body" type="VBoxContainer" parent="Dock/Inset/Palette"]
theme_override_constants/separation = 12

[node name="PaletteHeader" type="HBoxContainer" parent="Dock/Inset/Palette/Body"]
unique_name_in_owner = true

[node name="Heading" type="Label" parent="Dock/Inset/Palette/Body/PaletteHeader"]
size_flags_horizontal = 3
theme_type_variation = &"Heading"
text = "Construction"
theme_override_font_sizes/font_size = 30

[node name="Categories" type="HBoxContainer" parent="Dock/Inset/Palette/Body"]
unique_name_in_owner = true
theme_override_constants/separation = 5

[node name="Divider" type="HSeparator" parent="Dock/Inset/Palette/Body"]

[node name="Build" type="GridContainer" parent="Dock/Inset/Palette/Body"]
unique_name_in_owner = true
columns = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="ActionBar" type="PanelContainer" parent="Dock"]

[node name="Actions" type="HBoxContainer" parent="Dock/ActionBar"]
theme_override_constants/separation = 8

[node name="ToggleBuild" type="Button" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
toggle_mode = true
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Build"

[node name="Trips" type="Button" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Expeditions"

[node name="Services" type="MenuButton" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
flat = false
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Services"

[node name="Places" type="MenuButton" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
visible = false
flat = false
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Region"

[node name="ToolHint" type="Label" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
size_flags_horizontal = 3
autowrap_mode = 3
horizontal_alignment = 1
mouse_filter = 2
theme_override_font_sizes/font_size = 20

[node name="GuideButton" type="Button" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Guide"

[node name="Menu" type="Button" parent="Dock/ActionBar/Actions"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 45)
theme_override_constants/icon_max_width = 22
text = "Menu"

[node name="OpeningGuide" type="PanelContainer" parent="."]
visible = false
script = ExtResource("7_guide")

[node name="BuildingInfo" parent="." instance=ExtResource("2_info")]

[node name="PerimeterInfo" parent="." instance=ExtResource("3_perimeter")]

[node name="ExpeditionPanel" parent="." instance=ExtResource("4_trips")]

[node name="ServicePanel" parent="." instance=ExtResource("5_services")]

[node name="ResearchPanel" parent="." instance=ExtResource("6_tech")]
